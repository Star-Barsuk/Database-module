# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Example local development environment (database only)
# Copy this file to envs/.env.local and adjust values
# =============================================================================

# Project configuration
COMPOSE_PROJECT_NAME=myapp-local
COMPOSE_PROFILES=local-db

# Database configuration
DB_NAME_LOCAL=appdb_local
DB_USER_LOCAL=appuser_local
DB_PORT_LOCAL=5432

# Image version
POSTGRES_IMAGE=postgres:18.1-bookworm

# Resource limits
DB_CPU_LIMIT=0.3
DB_MEMORY_LIMIT=256M

# Application runs on host, connects to Docker database
# Database connection string for host application:
# postgresql://appuser_local:@localhost:5432/appdb_local
